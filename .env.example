# Environnement : "development" ou "production"
# C'est cette seule valeur qui fait basculer automatiquement tout le comportement du code :
# CORS, logs, et stockage des photos (local en dev, Cloudflare R2 en prod). Voir config/env.js.
ENV=development

# Serveur (ignoré sur Vercel, utilisé en local / autre hébergeur)
PORT=4000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wiisocket

# JWT
JWT_SECRET=change_this_to_a_long_random_secret

# Email OTP (Gmail) - utiliser un "mot de passe d'application" Google, pas le mdp du compte
# https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# CORS en production : URLs autorisées à appeler l'API, séparées par des virgules.
# Laisser vide = tout autorisé (pratique au début, à restreindre ensuite).
# Ex: CLIENT_ORIGINS=https://wiisocket.app,https://admin.wiisocket.app
CLIENT_ORIGINS=

# Cloudflare R2 - utilisé automatiquement quand ENV=production (voir services/storageService.js)
# npm install @aws-sdk/client-s3
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
