# Serveur
PORT=3000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wiisocket

# JWT
JWT_SECRET=change_this_to_a_long_random_secret

# Email OTP (Gmail) - utiliser un "mot de passe d'application" Google, pas le mdp du compte
# https://myaccount.google.com/apppasswords
EMAIL_USER=votre.adresse@gmail.com
EMAIL_PASS=xxxxxxxxxxxxxxxx

# Cloudflare R2 (à activer plus tard, voir services/storageService.js)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
